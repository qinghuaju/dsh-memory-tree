# Copy to `.env` (never commit) or export these before starting DSH.
#
# Embedding API key. Alternatively write:
#   $DSH_HOME/memory-tree/credentials.json  →  {"apiKey":"..."}
MEMORY_TREE_API_KEY=

# Optional overrides
# MEMORY_TREE_DATA_DIR=C:\Users\you\.dsh\memory-tree
# MEMORY_TREE_EMBED_PRESET=pollinations   # pollinations | dashscope | openai | ollama
# MEMORY_TREE_EMBED_MODEL=qwen/qwen3-embedding-8b
# MEMORY_TREE_EMBED_DIM=1024
# MEMORY_TREE_LOG_LEVEL=info
