{
  "name": "dsh-memory-tree",
  "version": "0.4.2",
  "description": "Shared long-term memory for DeepSeek Harness and Codex: AST + SQLite + embeddings, MCP tools and lifecycle hooks.",
  "type": "module",
  "main": "./src/plugin.mjs",
  "exports": {
    ".": "./src/plugin.mjs",
    "./engine": "./src/engine/index.mjs",
    "./runtime": "./src/runtime/service.mjs"
  },
  "bin": {
    "memory-tree-mcp": "./src/mcp/server.mjs",
    "memory-tree-codex-hook": "./src/codex/hook.mjs"
  },
  "files": [
    "src",
    "docs",
    "scripts",
    "tests",
    "README.md",
    "README.zh.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "LICENSE",
    "cordis.patch.yml",
    "market"
  ],
  "engines": {
    "node": ">=22.5.0",
    "dsh": "^0.2.1-alpha.2"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-llm": ">=0.1.0",
    "@deepseek-ai/dsh-tools": ">=0.1.0",
    "@deepseek-ai/schemastery": ">=3.18.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-llm": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  },
  "scripts": {
    "selftest": "node scripts/selftest.mjs",
    "test:codex": "node --test tests/codex.test.mjs",
    "test:compat": "node scripts/check-compat.mjs && node scripts/test-containment.mjs",
    "mcp": "node src/mcp/server.mjs",
    "codex:install": "node scripts/install-codex.mjs",
    "dryrun": "node scripts/dryrun-plugin.mjs",
    "live": "node scripts/selftest.mjs --live",
    "demo": "node scripts/demo.mjs",
    "inspect": "node scripts/inspect.mjs",
    "bench": "node scripts/bench.mjs",
    "market": "node scripts/market-index.mjs",
    "market:check": "node scripts/check-market.mjs",
    "compat": "node scripts/check-compat.mjs"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "codex",
    "mcp",
    "deepseek-harness",
    "memory",
    "long-term-memory",
    "sqlite",
    "embedding",
    "ast",
    "rag"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "cordis.patch.yml"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qinghuaju/dsh-memory-tree.git"
  },
  "homepage": "https://github.com/qinghuaju/dsh-memory-tree#readme",
  "bugs": {
    "url": "https://github.com/qinghuaju/dsh-memory-tree/issues"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.4.0",
    "smol-toml": "1.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.4.0"
  }
}
